{
  "rewrites": [
    {
      "source": "/api/py",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/py/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/py/health",
      "schedule": "0 12 * * *"
    }
  ]
}
